{
  "version": "2026-09-27-v5",
  "external_providers": [
    {
      "name": "Supabase",
      "host": "xqyasyambwdyhsjkftqu.supabase.co",
      "purposes": [
        "authentication",
        "database",
        "sync",
        "privacy_requests",
        "legal_assent",
        "cat_calibration",
        "guest_session_metrics",
        "suggestion_inbox"
      ]
    },
    {
      "name": "GitHub Pages",
      "purposes": [
        "static_hosting",
        "deployment"
      ]
    },
    {
      "name": "Google Apps Script",
      "host": "script.google.com",
      "purposes": [
        "question_reports"
      ]
    }
  ],
  "intentionally_excluded": [
    "patient_identifiers",
    "protected_health_information",
    "education_records",
    "grades",
    "government_ids",
    "precise_geolocation",
    "payment_card_data"
  ],
  "population_calibration_min_unique_learners": 25,
  "legal_assent_retention_years": 5,
  "sync_history_target_days": 90,
  "privacy_request_target_years": 3,
  "guest_session": {
    "identifier": "random sessionStorage UUID",
    "fields": [
      "session_id",
      "started_at",
      "last_seen_at"
    ],
    "retention_hours": 24,
    "admin_visibility": "aggregate counts only",
    "persistent_cross_session": false
  },
  "admin_account_metadata": [
    "email",
    "created_at",
    "last_sign_in_at",
    "access_status",
    "current_legal_accepted",
    "cat_used",
    "is_admin"
  ],
  "admin_account_actions": [
    "suspend_access",
    "grant_access",
    "delete_non_admin_account",
    "privacy_request_status",
    "legal_assent_export",
    "retention_cleanup",
    "suggestion_status"
  ],
  "suspension_enforcement": "client and server",
  "suggestion_inbox": {
    "requires_authenticated_active_account": true,
    "stored_fields": [
      "category",
      "message",
      "status",
      "created_at",
      "updated_at"
    ],
    "stored_account_identifier": false,
    "admin_visibility": "suggestion content and workflow status only",
    "max_message_characters": 1500
  }
}
